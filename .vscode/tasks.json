{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Build Debug",
      "type": "shell",
      "command": [
        "mkdir -p ${workspaceFolder}/build ;",
        "cd ${workspaceFolder}/build &&",
        "cmake -DCMAKE_BUILD_TYPE=Debug .. &&",
        "cmake --build . -j"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "clear": true },
      "problemMatcher": ["$gcc", "$cpp"]
    }
  ]
}
